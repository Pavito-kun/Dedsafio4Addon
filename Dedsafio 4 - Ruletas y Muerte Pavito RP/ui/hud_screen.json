  "dedsafio_sprite_flipbook": {
    "anim_type": "aseprite_flip_book",
    "initial_uv": [
      0,
      0
    ]
  },
  "dedsafio_sprite_alpha_in": {
    "anim_type": "alpha",
    "easing": "linear",
    "duration": "$title_fade_in_time",
    "from": 0,
    "to": 1,
    "next": "@hud.dedsafio_sprite_alpha_stay"
  },
  "dedsafio_sprite_alpha_stay": {
    "anim_type": "wait",
    "duration": "$title_stay_time",
    "next": "@hud.dedsafio_sprite_alpha_out"
  },
  "dedsafio_sprite_alpha_out": {
    "anim_type": "alpha",
    "easing": "linear",
    "duration": "$title_fade_out_time",
    "from": 1,
    "to": 0,
    "destroy_at_end": "dedsafio_sequence_overlay"
  },
