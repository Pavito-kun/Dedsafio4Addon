			},
			"minecraft:pushable": { "is_pushable": false, "is_pushable_by_piston": false },
			"minecraft:persistent": {},
			"minecraft:interact": {
				"interactions": [{
					"on_interact": { "filters": { "test": "is_family", "subject": "other", "value": "player" }, "event": "pavi:interact", "target": "self" },
					"swing": true,
					"interact_text": "action.interact.pavi_spaceship"
				}]
			}
		},
		"events": { "pavi:interact": {} }
